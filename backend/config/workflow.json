{
  "id": "chat-turn",
  "name": "One chat turn",
  "description": "Answer one user message with tools, knowledge and human approvals.",
  "start": [
    "assistant"
  ],
  "edges": [],
  "nodes": [
    {
      "id": "assistant",
      "type": "assistant",
      "name": "Chat assistant",
      "inputs": {
        "message": "/message",
        "conversation": "/conversation",
        "workspace": "/workspace"
      },
      "outputs": {
        "answer": "/answer"
      },
      "react": {
        "max_steps": 30,
        "on_step_limit": "answer"
      },
      "allowance": "risk-medium",
      "knowledge": {
        "read": [
          "assistant"
        ],
        "propose": [
          "assistant"
        ]
      },
      "allow_create_graph": true
    }
  ]
}
