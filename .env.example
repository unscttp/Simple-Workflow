# Copy to .env (git-ignored) and fill in what you use. docker compose reads .env
# automatically; for a local backend run:  set -a; . ./.env; set +a
# Keys for model providers are not set here: users enter their own in the browser.

# Scholarly search (OpenAlex). Without a key, a small free daily budget is shared
# by everyone on the server's IP address.
SW_OPENALEX_API_KEY=

# Web search: auto uses the first configured of Tavily, Brave and SearXNG,
# otherwise keyless DuckDuckGo/Wikipedia.
SW_SEARCH_PROVIDER=auto
SW_TAVILY_API_KEY=
SW_BRAVE_API_KEY=
SW_SEARXNG_URL=

# Model requests: automatic retries (0 = off) and how long to wait for an answer.
SW_MODEL_RETRIES=3
SW_MODEL_TIMEOUT_SECONDS=300
